---
interface Props {
  year: number;
  month: number; // 0-11
  availableDates: Set<string>;
}

const { year, month, availableDates } = Astro.props;

const monthName = new Date(year, month).toLocaleString("en-US", {
  month: "long",
});

const dayHeaders = ["S", "M", "T", "W", "T", "F", "S"];
const totalDays = new Date(year, month + 1, 0).getDate();
const startDay = new Date(year, month, 1).getDay();

type DayCell =
  | { type: "empty" }
  | { type: "day"; day: number; dateStr: string; hasData: boolean };

const cells: DayCell[] = [];

for (let i = 0; i < startDay; i++) {
  cells.push({ type: "empty" });
}

for (let day = 1; day <= totalDays; day++) {
  const dateStr = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
  const hasData = availableDates.has(dateStr);
  cells.push({ type: "day", day, dateStr, hasData });
}
---

<div class="rounded-lg border border-border bg-muted/40 p-4">
  <h3 class="mb-3 text-center text-lg font-semibold text-blue-700 dark:text-blue-300">
    {monthName}
  </h3>
  <div class="grid grid-cols-7 gap-1">
    {
      dayHeaders.map((header) => (
        <span class="py-1 text-center text-xs font-bold text-blue-700 dark:text-blue-300">
          {header}
        </span>
      ))
    }
    {
      cells.map((cell) =>
        cell.type === "empty" ? (
          <span />
        ) : cell.hasData ? (
          <a
            href={`/news/${cell.dateStr}/`}
            class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-blue-600 text-xs font-semibold text-white no-underline transition hover:scale-110 hover:bg-blue-700 dark:bg-blue-400 dark:text-slate-900 dark:hover:bg-blue-300"
          >
            {cell.day}
          </a>
        ) : (
          <span class="mx-auto flex h-8 w-8 cursor-default items-center justify-center text-xs text-muted-foreground">
            {cell.day}
          </span>
        ),
      )
    }
  </div>
</div>
