---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found – Bye Donald">
  <div class="mx-auto max-w-xl px-6 py-16">
    <h1 class="mb-4 text-3xl font-bold">Page not found</h1>
    <p class="mb-8 text-lg text-muted-foreground">
      Sorry, we couldn't find what you were looking for.
    </p>
    <a
      href="/"
      class="inline-block rounded-md bg-blue-600 px-5 py-2.5 font-semibold text-white no-underline transition hover:bg-blue-800"
    >
      Go home
    </a>
  </div>
</BaseLayout>
