---
import "../styles/globals.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title || "Bye Donald";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Prevent FOUC: apply dark mode before render
      (function () {
        var stored = localStorage.getItem("color-mode");
        if (
          stored === "dark" ||
          (!stored &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <script is:inline>
      // Google Analytics - respects Do Not Track
      (function () {
        var dnt =
          navigator.doNotTrack === "1" ||
          window.doNotTrack === "1" ||
          navigator.msDoNotTrack === "1";
        if (!dnt) {
          var script = document.createElement("script");
          script.async = true;
          script.src =
            "https://www.googletagmanager.com/gtag/js?id=G-KT2X9S6YZH";
          document.head.appendChild(script);

          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", "G-KT2X9S6YZH", {
            anonymize_ip: true,
            send_page_view: false,
          });
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <div class="flex min-h-screen flex-col">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
